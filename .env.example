# ==========================================================
# Amiros Football Analytics — Environment Variables
# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` file.
# ==========================================================

# Telegram bot token from @BotFather (for @Amirostailbot)
BOT_TOKEN=

# Numeric Telegram user ID of the administrator
# Get it by sending /start to @userinfobot on Telegram
ADMIN_TELEGRAM_ID=

# Public administrator username (without the leading @)
ADMIN_USERNAME=Amiros10

# Public Telegram channel username (without the leading @)
# A "Join Channel" button will be shown everywhere in the bot and Mini App.
CHANNEL_USERNAME=Amiros_1

# Public HTTPS URL of the deployed Mini App (Railway domain)
# Example: https://amiros-football-analytics.up.railway.app
WEB_APP_URL=

# Server port (Railway injects PORT automatically)
PORT=3000

# SQLite database file path.
# Point this at a Railway volume mount for persistence, e.g. /data/amiros.sqlite
DATABASE_PATH=./data/amiros.sqlite

# development | production
NODE_ENV=production

# Maximum accepted age (seconds) of Telegram Web App initData
INIT_DATA_MAX_AGE_SECONDS=86400
